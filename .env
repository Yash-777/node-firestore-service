# --- Firebase credential (used by common/src/config/serviceAccount.js) ---
# Option A: raw JSON or base64-encoded JSON of the service account key
FIREBASE_SERVICE_ACCOUNT=

# Option B: path to a service account JSON key file
FIREBASE_SERVICE_ACCOUNT_PATH=C:\Yashwanth\WorkSetup\NodeJS\serviceAccountKey.json

# --- Dynamic Firestore target (used by both webmodule/graphql and standalone/import) ---
# Firestore database id. Leave as "(default)" unless your project uses a
# named (non-default) Firestore database.
FIRESTORE_DATABASE_ID=(default)

# Slash-delimited collection path. This replaces the old hardcoded
# "master_data" / "countries" / "items" chain — change it here only.
FIRESTORE_COUNTRY_COLLECTION_PATH=master_data/countries/items
FIRESTORE_COUNTRYMASTER_COLLECTION_PATH=master_data/countrymaster/items
FIRESTORE_DEALER_COLLECTION_PATH=master_data/dealers/items

# --- webmodule/graphql server settings ---
NODE_ENV=development
PORT=4000
GRAPHQL_PATH=/graphql
GRAPHIQL_ENABLED=true
CORS_ALLOWED_ORIGINS=*
